{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pixl-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The Worker maps each hostname to its site's folder, so it runs before any asset.
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "pixlfoundation.com", "custom_domain": true },
    { "pattern": "www.pixlfoundation.com", "custom_domain": true },
    { "pattern": "playroom.pixlfoundation.com", "custom_domain": true },
    { "pattern": "space.pixlfoundation.com", "custom_domain": true },
    { "pattern": "engine.pixlfoundation.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": { "enabled": true },
  // Crash and problem reports, and crash symbols (worker/api.ts). Create the
  // bucket and its retention rules first: scripts/reports-bucket.sh.
  "r2_buckets": [{ "binding": "REPORTS", "bucket_name": "pixl-reports" }],
  // Reports per client (IP) per minute, across /api/crash and /api/report.
  "ratelimits": [
    { "name": "REPORT_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],
  "env": {
    // `pnpm preview`: no routes, so wrangler dev keeps each request's own host
    // (playroom.localhost:8787) instead of rewriting it to the first route.
    "local": { "routes": [], "workers_dev": false }
  }
}
