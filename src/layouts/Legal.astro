---
// A legal page (pixlfoundation.com, playroom. and space.pixlfoundation.com): a
// draft notice, the title and date, and the text. Playroom's pages copy the
// company site's, so their canonical is home's; Space Pixl's are its own.
import '../styles/legal.css'
import { canonical, href } from '../lib/links'
import { breadcrumbs } from '../lib/seo'
import { SITES, type SiteId } from '../lib/sites'
import Base from './Base.astro'

interface Props {
  site?: SiteId
  title: string
  summary: string
  updated?: string
  path: string
  /** Until a lawyer has reviewed it, a page says it isn't in effect. */
  draft?: boolean
  /** The site whose copy is canonical: home's by default, the page's own when it's that product's document. */
  canonicalSite?: SiteId
}

const { site = 'home', title, summary, updated, path, draft = true, canonicalSite = 'home' } = Astro.props
const nav = [
  { label: 'Licence agreement', to: href(site, '/legal/eula/', site) },
  { label: 'Privacy', to: href(site, '/legal/privacy/', site) },
  { label: 'Third-party notices', to: href(site, '/legal/third-party/', site) },
]
---

<Base
  site={site}
  title={`${title} · ${SITES[site].name}`}
  description={summary}
  path={path}
  nav={nav}
  backdrop={false}
  canonicalUrl={canonical(canonicalSite, path)}
  jsonLd={[breadcrumbs(canonicalSite, [{ name: SITES[canonicalSite].name, path: '/' }, { name: title, path }])]}
>
  <article class="wrap legal">
    <header>
      <span class="b-micro">Legal</span>
      <h1 class="b-disp">{title}</h1>
      <p class="b-body lede">{summary}</p>
      {updated && <p class="b-body updated">Last updated {new Date(updated).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</p>}
      {draft && <p class="b-body draft" role="note"><strong>Draft.</strong> This page is being prepared for launch and is not yet in effect. Words in [brackets] are still to be filled in.</p>}
    </header>
    <div class="prose b-body">
      <slot />
    </div>
  </article>
</Base>
