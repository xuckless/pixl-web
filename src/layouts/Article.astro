---
// A technical article on the engine site (/pixlrgb, /hdr, /codecs): the same
// head, nav and footer as the landing page, a narrow reading column, and an
// "on this page" list built from the sections the page passes in.
import Base from './Base.astro'
import '../styles/engine.css'
import '../styles/article.css'
import { softwareApp } from '../lib/seo'

interface Props {
  title: string
  description: string
  /** This page's path on the engine site, e.g. '/hdr/'. */
  path: string
  /** The small label above the title. */
  kicker: string
  /** The title as shown (may differ from the <title>). */
  heading: string
  lede: string
  /** The sections, in order, for the contents list: [id, label]. */
  toc: [string, string][]
  /** Extra structured data (e.g. a TechArticle). */
  jsonLd?: Record<string, unknown>[]
}

const { title, description, path, kicker, heading, lede, toc, jsonLd = [] } = Astro.props
---

<Base
  site="engine"
  title={title}
  description={description}
  path={path}
  nav={[
    { label: 'Colour science', to: '/pixlrgb/' },
    { label: 'HDR', to: '/hdr/' },
    { label: 'Codecs', to: '/codecs/' },
  ]}
  cta={{ label: 'Licensing', to: '/#licensing' }}
  jsonLd={[softwareApp('engine', { category: 'DeveloperApplication', os: 'macOS, Windows', description }), ...jsonLd]}
>
  <article class="wrap art">
    <header class="art-head">
      <a class="b-micro art-back" href="/">← PIXL Engine</a>
      <span class="b-micro art-kicker">{kicker}</span>
      <h1 class="b-disp">{heading}</h1>
      <p class="b-body art-lede">{lede}</p>
    </header>
    <div class="art-grid">
      <nav class="art-toc" aria-label="On this page">
        <span class="b-micro">On this page</span>
        <ol>{toc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
      </nav>
      <div class="art-body b-body">
        <slot />
      </div>
    </div>
  </article>
</Base>
