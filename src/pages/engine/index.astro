---
// engine.pixlfoundation.com, after the Family Kit's EnWebsite board, with
// every claim from pixl-engine's README (src/data/engine.ts).
import Base from '../../layouts/Base.astro'
import '../../styles/engine.css'
import Architecture from '../../components/engine/Architecture.astro'
import Mark from '../../components/brand/Mark.astro'
import Wordmark from '../../components/Wordmark.astro'
import { BEYOND, BINDINGS, FORMATS, MEASURED, OPS, STATS } from '../../data/engine'
import { href, origin } from '../../lib/links'
import { softwareApp } from '../../lib/seo'

const contact = 'mailto:hello@pixlfoundation.com?subject=PIXL%20Engine'
const fig = (f: string) => `/shared/engine/${f}`
const domain = (s: 'playroom' | 'space') => origin(s).replace(/^https?:\/\//, '')
---

<Base
  site="engine"
  title="PIXL Engine · One engine. Every pixel."
  description="PIXL Engine is the Rust imaging core behind every PIXL app. It decodes, grades and re-encodes photographs, fast and colour-true, does exactly what it is asked, and reports what it did."
  nav={[
    { label: 'Architecture', to: '#architecture' },
    { label: 'Apps', to: '#apps' },
    { label: 'Badge', to: '#badge' },
  ]}
  cta={{ label: 'Licensing', to: '#licensing' }}
  jsonLd={[
    softwareApp('engine', {
      category: 'DeveloperApplication',
      os: 'macOS, Windows',
      description: 'PIXL Engine is a Rust imaging core that decodes, grades, corrects and re-encodes photographs, with on-device AI, and Node and Swift bindings.'
    })
  ]}
>
  <!-- ── hero ─────────────────────────────────────────────────── -->
  <section class="wrap en-hero" aria-labelledby="hero-title">
    <div class="en-hero-copy">
      <span class="b-chip">Imaging core · Rust</span>
      <h1 class="b-disp" id="hero-title">One engine.<br />Every pixel.</h1>
      <p class="b-body lede">
        PIXL Engine decodes, grades and re-encodes photographs, fast and colour-true, with AI upscaling that runs on the
        device. Every PIXL app is built on it.
      </p>
      <div class="ctas">
        <a class="b-cta en" href="#licensing">Talk about licensing</a>
        <a class="b-cta sec" href="#architecture">See the architecture</a>
      </div>
    </div>
    <div class="en-hero-mark"><Mark kind="engine" size={540} glow label="PIXL Engine" /></div>
  </section>

  <section class="wrap" aria-label="In numbers">
    <ul class="en-stats">
      {STATS.map((s) => <li><span class="b-mono">{s.value}</span><span class="b-body">{s.label}</span></li>)}
    </ul>
  </section>

  <!-- ── architecture ─────────────────────────────────────────── -->
  <section class="wrap band" id="architecture" aria-labelledby="arch-title">
    <div class="sec-head">
      <div class="head-stack">
        <span class="b-micro">Architecture</span>
        <h2 class="b-disp h2" id="arch-title">Decoders in. One pipeline. Every app out.</h2>
      </div>
      <p class="b-body">
        Proven open decoders at the edge, the engine's own grade pipeline in the middle, and each product a different
        surface on the same core.
      </p>
    </div>
    <Architecture />
  </section>

  <section class="wrap band" aria-label="Why it holds up">
    <ul class="pillars">
      <li>
        <div class="b-rule en"></div>
        <h3 class="b-disp">Fast by construction</h3>
        <p class="b-body">Rust on proven libraries: libjpeg-turbo, libjxl, libheif and rawler. A full live-preview render takes 75 ms on 28 cores.</p>
      </li>
      <li>
        <div class="b-rule en"></div>
        <h3 class="b-disp">Colour you can trust</h3>
        <p class="b-body">Real conversions through Little CMS, never a quiet re-label. RAW goes out as lossless DNG, so none of the sensor data is thrown away.</p>
      </li>
      <li>
        <div class="b-rule en"></div>
        <h3 class="b-disp">AI that stays local</h3>
        <p class="b-body">Super resolution, denoise, JPEG restore, deblur and subject masks run through ONNX Runtime on the device's own hardware, and a provider that can't run is an error, never a silent fallback.</p>
      </li>
    </ul>
  </section>

  <!-- ── principle ────────────────────────────────────────────── -->
  <section class="wrap band" id="principle" aria-labelledby="principle-title">
    <div class="principle-grid">
      <div class="copy">
        <span class="b-micro">The one rule</span>
        <h2 class="b-disp h2" id="principle-title">It makes no decisions.<br /><span class="accent">It keeps the receipts.</span></h2>
        <p class="b-body">
          Most image libraries guess. They pick a quality for you, fall back to another codec when one fails, or quietly
          re-label colours they didn't convert. Every guess is a bug waiting in someone's photo library.
        </p>
        <p class="b-body">
          PIXL has no guesses to go wrong. The app decides, the engine does exactly that, and anything impossible is
          refused with the name of the setting to change.
        </p>
      </div>
      <figure class="receipt">
        <figcaption class="b-micro">convert() → report · abridged example</figcaption>
        <pre class="b-mono"><span class="k">colour</span>  sRGB (source IccProfile, converted)
        icc=true cicp=true
<span class="k">loss</span>    16→8 bits, 1 rounding,
        one float pass, dithered
<span class="k">grade</span>   white balance 7000 K
        exposure +0.18 · highlights −0.5
<span class="k">meta</span>    EXIF · ICC · XMP copied verbatim</pre>
        <p class="b-mono refusal"><span class="k">refused</span> hdr → sdr: the source uses PQ. Name a tone-mapping operator and both peaks, or choose an HDR-capable format.</p>
      </figure>
    </div>
  </section>

  <!-- ── what it does ─────────────────────────────────────────── -->
  <div id="does">
    <section class="wrap feature" aria-labelledby="d1">
      <div class="copy">
        <span class="b-micro">01 · Grading</span>
        <h2 class="b-disp h2" id="d1">A colourist's toolkit, rounded once.</h2>
        <p class="b-body">Each stage runs in the colour space it belongs in: white balance and exposure in linear light, the look on display values. However many operations you stack, the pixels are rounded once, at the end.</p>
        <div class="b-rule en"></div>
      </div>
      <figure class="figure"><img src={fig('grade.webp')} width="900" height="496" loading="lazy" decoding="async" alt="Before and after a colour grade: the same forest road, ungraded and then warmed with lifted shadows, pulled highlights, more contrast and more vibrance." /></figure>
    </section>
    <section class="wrap feature flip" aria-labelledby="d2">
      <div class="copy">
        <span class="b-micro">02 · Colour</span>
        <h2 class="b-disp h2" id="d2">Converting isn't re-labelling.</h2>
        <p class="b-body">A Display P3 photo can be tagged as sRGB or actually converted to it. They look alike until skin tones go grey. PIXL makes the caller say which, and reports which happened.</p>
        <div class="b-rule en"></div>
      </div>
      <figure class="figure"><img src={fig('colour.webp')} width="900" height="366" loading="lazy" decoding="async" alt="A Display P3 photo written as sRGB two ways, re-tagged and properly converted, with the amplified difference between them." /></figure>
    </section>
    <section class="wrap feature" aria-labelledby="d3">
      <div class="copy">
        <span class="b-micro">03 · RAW</span>
        <h2 class="b-disp h2" id="d3">A sensor mosaic is not an image.</h2>
        <p class="b-body">Turning a RAW into a picture is a series of choices, and PIXL leaves every one to the app. For archives, RAW to DNG is lossless and keeps the mosaic bit for bit.</p>
        <div class="b-rule en"></div>
      </div>
      <figure class="figure"><img src={fig('raw.webp')} width="900" height="360" loading="lazy" decoding="async" alt="One Canon CR2 rendered three ways: developed in linear light, developed with the sRGB curve, and the camera's embedded preview." /></figure>
    </section>
    <section class="wrap feature flip" aria-labelledby="d4">
      <div class="copy">
        <span class="b-micro">04 · Formats</span>
        <h2 class="b-disp h2" id="d4">Smaller isn't a guess.</h2>
        <p class="b-body">The same 8 MB JPEG is 68% smaller as AVIF and 20% bigger as HEIC. JPEG XL's repack is 19% smaller and reversible to the original byte.</p>
        <div class="b-rule en"></div>
      </div>
      <figure class="figure chart"><img src={fig('sizes.svg')} width="900" height="452" loading="lazy" decoding="async" alt="One 8.04 MB JPEG re-encoded eight ways: AVIF 2.58 MB, WebP 3.26 MB, JPEG XL 5.53 MB, JPEG XL repack 6.55 MB, HEIC 9.66 MB, JPEG XL lossless 22.93 MB, PNG 38.70 MB, TIFF 56.06 MB." /></figure>
    </section>
    <section class="wrap feature" aria-labelledby="d5">
      <div class="copy">
        <span class="b-micro">05 · HDR</span>
        <h2 class="b-disp h2" id="d5">HDR, handled on purpose.</h2>
        <p class="b-body">HDR stays HDR in formats that can hold it. Bringing it down to a normal screen means naming a tone-mapping operator and both peaks. Nothing is a default, and nothing is invented.</p>
        <div class="b-rule en"></div>
      </div>
      <figure class="figure chart"><img src={fig('tonemap.svg')} width="900" height="468" loading="lazy" decoding="async" alt="Measured transfer curves for four tone-mapping operators, Clip, BT.2390, Reinhard and Hable, plotting scene luminance against output code value." /></figure>
    </section>
  </div>

  <!-- ── capabilities + measured ──────────────────────────────── -->
  <section class="wrap band" aria-labelledby="cap-title">
    <div class="sec-head">
      <h2 class="b-disp h2" id="cap-title">Everything an editor needs.</h2>
      <p class="b-body">Every modern format in and out, and a full grading toolkit, with metadata copied verbatim and never "fixed".</p>
    </div>
    <div class="caps">
      <div>
        <h3 class="b-micro">Formats</h3>
        <ul class="fmt-list">{FORMATS.map((f) => <li><span class="b-disp">{f.name}</span><span class="b-body">{f.note}</span></li>)}</ul>
      </div>
      <div>
        <h3 class="b-micro">Grading operations</h3>
        <ul class="op-list b-body">{OPS.map((o) => <li>{o}</li>)}</ul>
        <h3 class="b-micro bind-title">Beyond the grade</h3>
        <ul class="op-list b-body">{BEYOND.map((o) => <li>{o}</li>)}</ul>
        <h3 class="b-micro bind-title">Use it from</h3>
        <ul class="op-list b-body">{BINDINGS.map((b) => <li><strong>{b.name}</strong> · {b.note}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="wrap band" id="measured" aria-labelledby="m-title">
    <div class="sec-head">
      <h2 class="b-disp h2" id="m-title">Measured, not claimed.</h2>
      <p class="b-body">Real files, real conversions, on an Apple M2 Pro. Nothing here is copied from a datasheet.</p>
    </div>
    <table class="measured">
      <caption class="sr-only">Conversion times and sizes</caption>
      <thead><tr><th scope="col">Conversion</th><th scope="col">In</th><th scope="col">Out</th><th scope="col">Time</th></tr></thead>
      <tbody>{MEASURED.map((m) => <tr><th scope="row">{m.what}</th><td class="b-mono">{m.from}</td><td class="b-mono">{m.to}</td><td class="b-mono">{m.time}</td></tr>)}</tbody>
    </table>
  </section>

  <!-- ── apps ─────────────────────────────────────────────────── -->
  <section class="wrap band" id="apps" aria-labelledby="apps-title">
    <div class="head-stack">
      <span class="b-micro">Built on it</span>
      <h2 class="b-disp h2" id="apps-title">Two apps today. The same core under both.</h2>
    </div>
    <div class="apps">
      <a class="app-card pl" href={href('playroom', '/', 'engine')}>
        <Mark kind="playroom" size={150} glow />
        <div>
          <Wordmark site="playroom" size={20} />
          <p class="b-body">A RAW developer you buy once. Uses the whole engine: decode, grade, export, upscale.</p>
          <span class="b-mono">{domain('playroom')}</span>
        </div>
      </a>
      <a class="app-card sp" href={href('space', '/', 'engine')}>
        <Mark kind="space" size={150} glow />
        <div>
          <Wordmark site="space" size={20} />
          <p class="b-body">Makes photo libraries smaller. Uses the engine's analysis and encoders.</p>
          <span class="b-mono">{domain('space')}</span>
        </div>
      </a>
    </div>
  </section>

  <!-- ── badge ────────────────────────────────────────────────── -->
  <section class="wrap band badge-sec" id="badge" aria-labelledby="badge-title">
    <div class="copy">
      <span class="b-micro">Badge</span>
      <h2 class="b-disp h2" id="badge-title">Say what's underneath.</h2>
      <p class="b-body">Products built on the engine can carry the Powered by PIXL Engine badge on store pages, download pages and splash screens.</p>
    </div>
    <div class="badges">
      <div class="badge big">
        <Mark kind="engine" size={56} glow pixels={false} />
        <div><span class="b-micro">Powered by</span><span class="b-wm en">PIXL <em>ENGINE</em></span></div>
      </div>
      <div class="badge small">
        <Mark kind="engine" size={24} detail="small" />
        <span class="b-wm en">PIXL <em>ENGINE</em></span>
      </div>
    </div>
  </section>

  <!-- ── who it's for ─────────────────────────────────────────── -->
  <section class="wrap band" aria-labelledby="who-title">
    <h2 class="b-disp h2" id="who-title">Who it's for</h2>
    <ul class="cards">
      <li>
        <h3 class="b-disp">Partners &amp; licensing</h3>
        <p class="b-body">Put the engine under your own product: decoding, grading and encoding as one Rust library, with on-device AI.</p>
        <a class="b-micro go" href="#licensing">Talk to us →</a>
      </li>
      <li>
        <h3 class="b-disp">App makers</h3>
        <p class="b-body">Ship on a core that already carries two apps, from Swift, Kotlin or Node, and say so with the badge.</p>
        <a class="b-micro go" href="#badge">Get the badge →</a>
      </li>
      <li>
        <h3 class="b-disp">Engineers</h3>
        <p class="b-body">Thirteen calls, one rounding, and a report for every conversion: how the pieces fit together.</p>
        <a class="b-micro go" href="#architecture">Read the architecture →</a>
      </li>
    </ul>
  </section>

  <!-- ── licensing ────────────────────────────────────────────── -->
  <section class="wrap" id="licensing" aria-labelledby="lic-title">
    <div class="licensing">
      <div>
        <h2 class="b-disp" id="lic-title">Build on PIXL Engine.</h2>
        <p class="b-body">Licensing, partnerships and investment: <a class="textlink" href={contact}>hello@pixlfoundation.com</a></p>
      </div>
      <a class="b-cta en" href={contact}>Get in touch</a>
    </div>
  </section>
</Base>
