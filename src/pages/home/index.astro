---
// pixlfoundation.com, after the Family Kit's FoWebsite board: the word in
// pixels, the products, what they share, the engine under them, and a way to
// say hello.
import Base from '../../layouts/Base.astro'
import '../../styles/home.css'
import Bitmap from '../../components/brand/Bitmap.astro'
import Mark from '../../components/brand/Mark.astro'
import Wordmark from '../../components/Wordmark.astro'
import { PRICE } from '../../data/playroom'
import { href, origin } from '../../lib/links'
import type { MarkKind } from '../../lib/marks'

const contact = 'mailto:hello@pixlfoundation.com'
const domain = (k: MarkKind): string => origin(k).replace(/^https?:\/\//, '')

const PRODUCTS: { kind: MarkKind; status: string; text: string }[] = [
  {
    kind: 'playroom',
    status: `Coming soon · ${PRICE.amount} once`,
    text: 'A professional RAW developer. No import, no catalog, and you pay once.'
  },
  {
    kind: 'space',
    status: 'Coming soon',
    text: 'Makes photo libraries smaller: it measures every file, and writes the new one beside the original.'
  },
  {
    kind: 'engine',
    status: 'Inside every PIXL app',
    text: 'The Rust imaging core under both, for partners who want to build on it.'
  }
]

const SHARED = [
  {
    title: 'One engine',
    text: 'Every app runs on PIXL Engine, so a faster decoder or a better colour transform lands in all of them at once.'
  },
  {
    title: 'On your device',
    text: 'Editing, conversion and AI upscaling run on your own computer. Your photos are not uploaded to be processed.'
  },
  {
    title: 'Your files stay yours',
    text: 'No import and no catalog in Playroom. Space Pixl writes beside your originals and never overwrites one.'
  }
]
---

<Base
  site="home"
  title="PIXL Foundation · Imaging software, from the pixel up"
  description="PIXL Foundation makes PIXL Engine, a Rust imaging core, and the photo apps that run on it: Pixl Playroom and Space Pixl. Software you pay for once, that runs on your own computer."
  nav={[
    { label: 'Products', to: '#products' },
    { label: 'About', to: '#about' },
    { label: 'Press', to: '#press' },
  ]}
  cta={{ label: 'Contact', to: '#contact' }}
>
  <!-- ── hero: the word, scanned in ─────────────────────────────── -->
  <section class="wrap fo-hero" aria-labelledby="hero-title">
    <div class="fo-word">
      <Bitmap indexed class="reveal" label="PIXL" />
      <script is:inline>
        // Hide the cells before the first paint, so the scan starts from nothing.
        // Reduced motion (and no script, and crawlers) see the word as it is.
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
          document.currentScript.previousElementSibling.classList.add('scanning')
      </script>
    </div>
    <div class="fo-lede">
      <h1 class="b-disp" id="hero-title">Imaging software,<br />from the pixel up.</h1>
      <p class="b-body">
        PIXL Foundation makes PIXL Engine, a Rust imaging core, and the apps that run on it: photo software you pay for
        once, that works on your own computer.
      </p>
    </div>
  </section>

  <!-- ── products ─────────────────────────────────────────────── -->
  <section class="wrap band" id="products" aria-labelledby="products-title">
    <div class="sec-head">
      <h2 class="b-disp h2" id="products-title">Products</h2>
      <p class="b-body">Two apps, and the engine under them.</p>
    </div>
    <div class="products">
      {
        PRODUCTS.map((p) => (
          <a class:list={['product', p.kind]} href={href(p.kind, '/', 'home')}>
            <div class="product-mark">
              <Mark kind={p.kind} size={170} glow />
            </div>
            <Wordmark site={p.kind} size={18} />
            <p class="b-body">{p.text}</p>
            <span class="b-micro status">{p.status}</span>
            <div class="product-foot">
              <span class="b-mono">{domain(p.kind)}</span>
              <span class="b-micro visit">Visit →</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ── what they share ──────────────────────────────────────── -->
  <section class="wrap band" aria-labelledby="share-title">
    <h2 class="b-disp h2" id="share-title">What they share</h2>
    <ul class="shared">
      {
        SHARED.map((s) => (
          <li>
            <svg class="pix" width="21" height="21" viewBox="0 0 3 3" shape-rendering="crispEdges" aria-hidden="true">
              <rect width="3" height="3" fill="currentColor" />
            </svg>
            <h3 class="b-disp">{s.title}</h3>
            <p class="b-body">{s.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ── about: one core, every app wraps it ──────────────────── -->
  <section class="wrap band about" id="about" aria-labelledby="about-title">
    <div class="copy">
      <span class="b-micro">About</span>
      <h2 class="b-disp h2" id="about-title">One core,<br />every app wraps it.</h2>
      <p class="b-body">
        PIXL Foundation is independent, and makes the photo tools we want to use ourselves. The engine comes first: it
        does exactly what it is asked and reports what it did. Each app is a different surface on it.
      </p>
      <ul class="principles b-body">
        <li><strong>A strong base first.</strong> Every app is complete on its own; nothing essential is held back for an add-on.</li>
        <li><strong>Pay once.</strong> Optional cloud extras, when they come, stay optional.</li>
        <li><strong>No guessing.</strong> Nothing happens to a photo in secret.</li>
      </ul>
      <p class="b-body maker-note">
        Built by Syed Ali (<a class="textlink" href="https://github.com/xuckless">github.com/xuckless</a>), an independent
        developer in Ontario, Canada, who designed the engine, the apps and these sites. PIXL Foundation is a for-profit
        business, soon to be registered as a company.
      </p>
      <div class="about-links">
        <a class="textlink b-body" href={href('engine', '/', 'home')}>How the engine works</a>
        <a class="textlink b-body" href={href('home', '/legal/', 'home')}>Who we are</a>
      </div>
    </div>
    <div class="tree" aria-label="PIXL Foundation makes PIXL Engine, which Pixl Playroom and Space Pixl are built on" role="img">
      <Bitmap cell={4} label="" />
      <span class="stem" />
      <div class="tree-engine"><Mark kind="engine" size={72} /><span class="b-micro">Engine</span></div>
      <span class="branch" />
      <div class="tree-apps">
        <div><Mark kind="playroom" size={64} pixels={false} /><span class="b-micro">Playroom</span></div>
        <div><Mark kind="space" size={64} /><span class="b-micro">Space Pixl</span></div>
      </div>
    </div>
  </section>

  <!-- ── press ────────────────────────────────────────────────── -->
  <section class="wrap band" id="press" aria-labelledby="press-title">
    <div class="sec-head">
      <h2 class="b-disp h2" id="press-title">Press</h2>
      <p class="b-body">Logos in every tone as SVG and PNG, the colours, and how to use them. Built from the brand's own masters.</p>
    </div>
    <ul class="press">
      <li><a href="/shared/press/foundation.zip" download><Bitmap cell={2} label="" /><span class="name">PIXL Foundation</span><span class="b-micro">Press kit ↓</span></a></li>
      <li><a href="/shared/press/engine.zip" download><Mark kind="engine" size={40} detail="small" /><span class="name">PIXL Engine</span><span class="b-micro">Press kit ↓</span></a></li>
      <li><a href="/shared/press/playroom.zip" download><Mark kind="playroom" size={40} detail="small" /><span class="name">Pixl Playroom</span><span class="b-micro">Press kit ↓</span></a></li>
      <li><a href="/shared/press/space.zip" download><Mark kind="space" size={40} detail="small" /><span class="name">Space Pixl</span><span class="b-micro">Press kit ↓</span></a></li>
    </ul>
  </section>

  <!-- ── contact ──────────────────────────────────────────────── -->
  <section class="wrap" id="contact" aria-labelledby="contact-title">
    <div class="contact">
      <div class="contact-grid" aria-hidden="true"></div>
      <div class="contact-copy">
        <h2 class="b-disp" id="contact-title">Say hello.</h2>
        <p class="b-body">Press, partnerships and everything else: <a class="textlink" href={contact}>hello@pixlfoundation.com</a></p>
      </div>
      <a class="b-cta fo" href={contact}>Email us</a>
    </div>
  </section>
</Base>

<script>
  // The Family Kit's scanline reveal: the word drawn like a frame being scanned
  // out, row by row, left to right, one cell at a time (0.4 s wait, 1.8 s scan).
  const svg = document.querySelector<SVGSVGElement>('.fo-word svg.scanning')
  if (svg) {
    const cells = [...svg.querySelectorAll<SVGRectElement>('rect[data-i]')].sort(
      (a, b) => Number(a.dataset.i) - Number(b.dataset.i)
    )
    const ns = 'http://www.w3.org/2000/svg'
    const head = document.createElementNS(ns, 'rect')
    head.setAttribute('width', '1')
    head.setAttribute('height', '1')
    head.setAttribute('fill', '#ffffff')
    const row = document.createElementNS(ns, 'rect')
    row.setAttribute('x', '0')
    row.setAttribute('width', '20')
    row.setAttribute('height', '1')
    row.setAttribute('fill', '#ffffff')
    row.setAttribute('opacity', '0.05')
    svg.append(row, head)
    const DELAY = 400
    const DURATION = 1800
    let shown = 0
    let t0 = 0
    const step = (t: number): void => {
      if (!t0) t0 = t
      const n = Math.min(cells.length, Math.max(0, ((t - t0 - DELAY) / DURATION) * cells.length))
      for (; shown < Math.floor(n); shown++) cells[shown].classList.add('on')
      const next = cells[Math.min(shown, cells.length - 1)]
      if (n > 0 && n < cells.length) {
        head.setAttribute('x', String(Number(next.getAttribute('x')) + 0.02))
        head.setAttribute('y', String(Number(next.getAttribute('y')) + 0.02))
        row.setAttribute('y', String(Number(next.getAttribute('y')) + 0.02))
      }
      if (shown < cells.length) requestAnimationFrame(step)
      else {
        head.remove()
        row.remove()
        svg.classList.remove('scanning')
      }
    }
    requestAnimationFrame(step)
  }
</script>
