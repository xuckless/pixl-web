---
// space.pixlfoundation.com, after the Family Kit's SpWebsite board. The
// screenshots come from the app itself (space-pixl's scripts/shots.mjs, with
// the real engine on the engine's own test images). Figures are the engine's
// measurements (pixl-engine README), which Space Pixl's recommender uses.
import Base from '../../layouts/Base.astro'
import '../../styles/space.css'
import Mark from '../../components/brand/Mark.astro'
import Wordmark from '../../components/Wordmark.astro'
import { href } from '../../lib/links'
import { softwareApp } from '../../lib/seo'

const own = (p: string) => href('space', p, 'space')

const notify = 'mailto:hello@pixlfoundation.com?subject=Tell%20me%20when%20Space%20Pixl%20launches'
const icon = { mail: 'M4 6h16v12H4zM4 7l8 6 8-6' }
const READS = ['Camera RAW', 'DNG', 'JPEG', 'HEIC', 'PNG', 'WebP', 'JPEG XL']
const WRITES = ['JPEG XL', 'AVIF', 'WebP', 'DNG', 'JPEG']
const WAYS = [
  { name: 'JPEG → JPEG XL', tag: 'Lossless', ok: true, figure: 'saves 19%', text: 'Repacked without decoding a pixel, and reversible: the original JPEG can be rebuilt byte for byte.' },
  { name: 'RAW → DNG', tag: 'Lossless', ok: true, figure: 'saves 14%', text: 'Every sensor value kept bit for bit, with the camera’s own metadata written across.' },
  { name: 'JPEG → AVIF', tag: 'Compact', ok: false, figure: 'saves 68%', text: 'The biggest saving when a close visual match is enough. You see the result before you commit.' },
  { name: 'JPEG → HEIC', tag: 'The trap', ok: false, warn: true, figure: '20% bigger', text: 'Newer isn’t always smaller. Space Pixl measures first, so it never recommends a conversion that grows your library.' }
]
---

<Base
  site="space"
  title="Space Pixl · More space. Same pixels."
  description="Space Pixl makes a photo library smaller. It measures every photo, recommends only conversions that save space, previews the real result, and writes the new file beside the original, never over it."
  nav={[
    { label: 'How it works', to: '#how' },
    { label: 'Formats', to: '#formats' },
    { label: 'Engine', to: '#engine' },
  ]}
  cta={{ label: 'Get notified', to: '#get' }}
  jsonLd={[
    softwareApp('space', {
      category: 'UtilitiesApplication',
      os: 'macOS, Windows',
      description: 'Space Pixl makes a photo library smaller: it measures every photo, recommends only conversions that save space, and writes the new file beside the original.'
    })
  ]}
>
  <!-- ── hero ─────────────────────────────────────────────────── -->
  <section class="wrap hero" aria-labelledby="hero-title">
    <span class="b-chip sp">Photo library optimiser for macOS and Windows</span>
    <h1 class="b-disp" id="hero-title">More space.<br /><span class="accent">Same pixels.</span></h1>
    <p class="b-body lede">
      Space Pixl looks at every photo in a folder, tells you whether converting it is worth it, and writes the smaller
      file beside the original. Lossless when you want every bit back, compact when you don't.
    </p>
    <div class="ctas">
      <a class="b-cta sp" href={notify}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon.mail}></path></svg>Tell me when it launches</a>
      <a class="b-cta sec" href="#how">See how it works</a>
    </div>
    <p class="b-body fine-hero">Coming soon · your originals are never touched</p>
    <figure class="b-win sp shot hero-shot">
      <img src={own('/shots/optimise.webp')} width="1600" height="1000" decoding="async" fetchpriority="high" alt="Space Pixl's Optimise view: a 34 MB camera RAW recommended for lossless DNG, with a split before-and-after preview showing 29.35 MB, 13.7% smaller and a bit-exact copy." />
    </figure>
  </section>

  <section class="wrap" id="formats" aria-label="Formats">
    <div class="formats">
      <div><span class="b-micro">Reads</span><ul>{READS.map((f) => <li>{f}</li>)}</ul></div>
      <div class="writes"><span class="b-micro">Writes</span><ul>{WRITES.map((f) => <li>{f}</li>)}</ul></div>
    </div>
  </section>

  <!-- ── how it works ─────────────────────────────────────────── -->
  <div id="how">
    <section class="wrap feature" aria-labelledby="s1">
      <div class="copy">
        <span class="b-micro">01 · Analyse</span>
        <h2 class="b-disp h2" id="s1">Every file gets a verdict.</h2>
        <p class="b-body">Open a photo or a folder and Space Pixl measures it first: what it is, how it was made, and what each target would save. It recommends one, and says plainly when a conversion isn't worth it.</p>
        <div class="b-rule sp"></div>
      </div>
      <figure class="b-win sp shot">
        <img src={own('/shots/analysis.webp')} width="1600" height="1000" loading="lazy" decoding="async" alt="The analysis of a camera RAW: its format, size and samples, how it was made (an undemosaiced sensor mosaic), and a luminance histogram with percentiles." />
      </figure>
    </section>

    <section class="wrap feature flip" aria-labelledby="s2">
      <div class="copy">
        <span class="b-micro">02 · Convert</span>
        <h2 class="b-disp h2" id="s2">Beside the original, never over it.</h2>
        <p class="b-body">The new file lands next to the old one with the same name. Nothing is moved, replaced or deleted for you. Every setting you change runs the real encode first, so the size you see is the size you get.</p>
        <div class="b-rule sp"></div>
      </div>
      <div class="files" role="img" aria-label="A folder showing IMG_0042.CR2 at 35.67 MB, untouched, and beside it the new IMG_0042.dng at 30.77 MB, lossless.">
        <div class="files-path b-mono">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 7h6l2 2h10v10H3z"></path></svg>
          ~/Pictures/Lakeshore
        </div>
        <div class="file">
          <span class="b-mono">IMG_0042.CR2</span><span class="b-mono size">35.67 MB</span><span class="pill">original · untouched</span>
        </div>
        <div class="file new">
          <span class="b-mono">IMG_0042.dng</span><span class="b-mono size ok">30.77 MB</span><span class="pill ok">new · lossless</span>
        </div>
        <div class="tags">
          <span class="tag ok b-mono">sensor data bit for bit</span>
          <span class="tag sp b-mono">−14%</span>
          <span class="tag b-mono">camera metadata kept</span>
        </div>
        <p class="b-body">Same name, new extension, written next to the original. Delete the original yourself once you're happy.</p>
      </div>
    </section>

    <section class="wrap feature" aria-labelledby="s3">
      <div class="copy">
        <span class="b-micro">03 · Stats</span>
        <h2 class="b-disp h2" id="s3">Watch the space come back.</h2>
        <p class="b-body">Every finished conversion counts towards the space you've reclaimed, so you can see what the library gave back.</p>
        <div class="b-rule sp"></div>
      </div>
      <figure class="b-win sp shot">
        <img src={own('/shots/stats.webp')} width="1600" height="1000" loading="lazy" decoding="async" alt="Space Pixl's Stats: storage reclaimed across two conversions, the average reduction, what was saved without loss, and a 30-day chart." />
      </figure>
    </section>
  </div>

  <!-- ── ways ─────────────────────────────────────────────────── -->
  <section class="wrap band" aria-labelledby="ways-title">
    <div class="sec-head">
      <h2 class="b-disp h2" id="ways-title">Four conversions, measured.</h2>
      <p class="b-body">From one 8 MB JPEG and one 35.6 MB Canon CR2 in the engine's test set. Your files will differ, and Space Pixl tells you by how much before you convert.</p>
    </div>
    <ul class="ways">
      {
        WAYS.map((w, i) => (
          <li class:list={{ first: i === 0, warn: w.warn }}>
            <div class="way-head"><h3 class="b-disp">{w.name}</h3><span class:list={['pill', { ok: w.ok, warn: w.warn }]}>{w.tag}</span></div>
            <span class:list={['b-mono way-fig', { ok: w.ok, warn: w.warn }]}>{w.figure}</span>
            <p class="b-body">{w.text}</p>
          </li>
        ))
      }
    </ul>
    <figure class="figure chart ways-chart"><img src="/shared/engine/sizes.svg" width="900" height="452" loading="lazy" decoding="async" alt="One 8.04 MB JPEG re-encoded eight ways: AVIF 2.58 MB, WebP 3.26 MB, JPEG XL 5.53 MB, JPEG XL repack 6.55 MB, HEIC 9.66 MB, JPEG XL lossless 22.93 MB, PNG 38.70 MB, TIFF 56.06 MB." /></figure>
  </section>

  <!-- ── engine ───────────────────────────────────────────────── -->
  <section class="wrap" id="engine" aria-labelledby="engine-title">
    <a class="engine-card sp-engine" href={href('engine', '/', 'space')}>
      <div class="copy">
        <Wordmark site="engine" size={16} />
        <h2 class="b-disp h2" id="engine-title">Rust underneath.<br />It can crash; your app won't.</h2>
        <p class="b-body">Space Pixl runs on PIXL Engine, the same imaging core as Pixl Playroom. The engine runs as its own process, so if it ever falls over it restarts without taking the app down with it.</p>
        <div class="en-facts">
          <div><span class="b-mono">separate</span><span class="b-body">process, auto-restart</span></div>
          <div><span class="b-mono">1 rounding</span><span class="b-body">per conversion</span></div>
          <div><span class="b-mono">0.51 s</span><span class="b-body">a CR2 to DNG</span></div>
        </div>
      </div>
      <Mark kind="engine" size={300} glow class="engine-mark" />
    </a>
  </section>

  <!-- ── get ──────────────────────────────────────────────────── -->
  <section class="wrap closing" id="get" aria-labelledby="get-title">
    <Mark kind="space" size={150} glow label="" />
    <h2 class="b-disp" id="get-title">Get the space back.</h2>
    <p class="b-body closing-lede">Coming soon for macOS and Windows. Updates install in the background, on the Stable or Beta channel.</p>
    <div class="ctas">
      <a class="b-cta sp" href={notify}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon.mail}></path></svg>Tell me when it launches</a>
      <a class="b-cta sec" href={href('playroom', '/', 'space')}>Meet Playroom</a>
    </div>
  </section>
</Base>
