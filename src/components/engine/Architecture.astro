---
// PIXL Engine's architecture, after the Family Kit's EnDiagram board: proven
// decoders in, the engine's one float pipeline in PixlRGB in the middle, the
// apps out. Facts from pixl-engine's CLAUDE.md (format matrix, the master).
import Mark from '../brand/Mark.astro'

const INPUTS = [
  { name: 'Camera RAW · DNG', lib: 'LibRaw 0.22 · PIXL DNG 1.7.1 reader' },
  { name: 'HEIC · AVIF', lib: 'libheif · PIXL’s own chroma, Apple-exact' },
  { name: 'JPEG XL · JPEG · PNG', lib: 'libjxl · libjpeg-turbo · TIFF, WebP' }
]
const STAGES = [
  { n: '1 · Develop', text: 'Decode, PIXL camera colour, into linear PixlRGB floats' },
  { n: '2 · Edit', text: 'Lens, retouch, layered grades and masks, guarded' },
  { n: '3 · Master', text: 'One HDR master: peak, ceiling, tone map, gamut' },
  { n: '4 · Encode', text: 'AVIF, JPEG XL, JPEG, PNG, TIFF, WebP, DNG' }
]
---

<div class="arch" role="img" aria-label="Decoders for RAW and DNG, HEIC and AVIF, JPEG XL, JPEG and PNG feed PIXL Engine's pipeline: develop into linear PixlRGB, edit, one HDR master, encode. Pixl Playroom and Space Pixl are built on it.">
  <div class="arch-col">
    <span class="b-micro">In</span>
    {INPUTS.map((i) => <div class="arch-in"><span class="name">{i.name}</span><span class="b-mono">{i.lib}</span></div>)}
  </div>
  <div class="arch-links in" aria-hidden="true"><i></i><i></i><i></i><b></b></div>
  <div class="arch-core">
    <div class="arch-head">
      <Mark kind="engine" size={64} glow />
      <div>
        <span class="b-wm en">PIXL <em>ENGINE</em></span>
        <span class="b-mono">Rust · Node and Electron bindings</span>
      </div>
    </div>
    <div class="arch-stages">
      {STAGES.map((s, i) => <div class:list={['stage', { hot: i === 0 || i === 2 }]}><span class="b-micro">{s.n}</span><span class="b-body">{s.text}</span></div>)}
    </div>
    <p class="b-body arch-note">One convert() call runs the whole pipeline in 32-bit float, the same at any thread count, and rounds the pixels to integers once, at the end.</p>
    <div class="arch-extras">
      <div><span class="name">Colour</span><span class="b-mono">PixlRGB · ICtCp · Little CMS, ICC and CICP</span></div>
      <div><span class="name">HDR</span><span class="b-mono">PQ · HLG · ISO 21496-1 gain maps</span></div>
      <div><span class="name">AI</span><span class="b-mono">ONNX Runtime · CPU, CoreML, CUDA, DirectML</span></div>
    </div>
  </div>
  <div class="arch-links out" aria-hidden="true"><i></i><i></i><i class="dash"></i></div>
  <div class="arch-col">
    <span class="b-micro">Apps</span>
    <div class="arch-app pl"><Mark kind="playroom" size={52} pixels={false} /><div><span class="name">Pixl Playroom</span><span class="b-body">Develop, grade, upscale</span></div></div>
    <div class="arch-app sp"><Mark kind="space" size={52} /><div><span class="name">Space Pixl</span><span class="b-body">Analyse and convert libraries</span></div></div>
    <div class="arch-app next"><span class="name">Next app</span></div>
  </div>
</div>

<style>
  .arch { display: grid; grid-template-columns: minmax(0, 300px) 70px minmax(0, 1fr) 70px minmax(0, 300px); align-items: stretch; }
  .arch-col { display: grid; grid-template-rows: 20px repeat(3, 100px); gap: 30px; align-content: center; }
  .arch-in, .arch-app { box-sizing: border-box; padding: 18px 22px; border: 1px solid rgba(255, 255, 255, .12); background: #09090b; display: flex; flex-direction: column; justify-content: center; gap: 8px; }
  .name { font-family: 'Space Grotesk', system-ui, sans-serif; font-size: 19px; font-weight: 600; color: var(--ink); }
  .arch-in .b-mono { font-size: 13px; color: var(--ink-3); }
  .arch-app { flex-direction: row; align-items: center; gap: 14px; padding: 0 18px; }
  .arch-app > div { display: flex; flex-direction: column; gap: 4px; }
  .arch-app .b-body { font-size: 13px; color: var(--ink-3); }
  .arch-app.pl { border-color: rgba(157, 139, 234, .4); background: #0c0a16; }
  .arch-app.sp { border-color: rgba(147, 164, 255, .4); background: #0b0d14; }
  .arch-app.next { border: 1px dashed rgba(255, 255, 255, .2); background: none; }
  .arch-app.next .name { color: var(--ink-3); }

  /* the connectors: lines that brighten towards the engine, with a pixel where they land */
  .arch-links { position: relative; }
  .arch-links i { position: absolute; left: 6px; right: 6px; height: 1.5px; background: linear-gradient(90deg, rgba(255, 255, 255, .1), rgba(187, 169, 255, .6) 75%, #e6dfff); }
  .arch-links.in i:nth-child(1) { top: calc(50% - 130px); transform: rotate(38deg); transform-origin: 0 50%; width: 80px; }
  .arch-links.in i:nth-child(2) { top: 50%; }
  .arch-links.in i:nth-child(3) { top: calc(50% + 130px); transform: rotate(-38deg); transform-origin: 0 50%; width: 80px; }
  .arch-links.in b { position: absolute; right: 2px; top: calc(50% - 3.5px); width: 8px; height: 8px; background: #e6dfff; }
  .arch-links.out i:nth-child(1) { top: 50%; transform: rotate(-38deg); transform-origin: 0 50%; width: 80px; }
  .arch-links.out i:nth-child(2) { top: 50%; }
  .arch-links.out i:nth-child(3) { top: 50%; transform: rotate(38deg); transform-origin: 0 50%; width: 80px; }
  .arch-links.out i.dash { background: repeating-linear-gradient(90deg, rgba(230, 223, 255, .6) 0 4px, transparent 4px 9px); }

  .arch-core {
    box-sizing: border-box; padding: 32px 34px; display: flex; flex-direction: column; gap: 22px;
    border: 1px solid rgba(255, 255, 255, .14);
    background: linear-gradient(160deg, rgba(157, 139, 234, .12), rgba(23, 18, 43, .6) 50%, rgba(0, 0, 0, .4));
    box-shadow: 0 30px 120px -50px rgba(157, 139, 234, .5);
  }
  .arch-head { display: flex; align-items: center; gap: 18px; }
  .arch-head > div { display: flex; flex-direction: column; gap: 8px; }
  .arch-head .b-wm { font-size: 19px; }
  .arch-head .b-mono { font-size: 13px; color: var(--ink-3); }
  .arch-stages { display: flex; flex-direction: column; gap: 8px; }
  .stage { padding: 13px 16px; border: 1px solid rgba(255, 255, 255, .14); background: rgba(0, 0, 0, .35); display: grid; grid-template-columns: 116px minmax(0, 1fr); gap: 16px; align-items: baseline; }
  .stage .b-micro { white-space: nowrap; }
  .stage.hot { border-color: rgba(187, 169, 255, .45); background: rgba(23, 18, 43, .6); }
  .stage .b-micro { color: #bba9ff; }
  .stage .b-body { font-size: 14px; color: var(--ink-2); }
  .arch-note { margin: -8px 0 0; font-size: 14px; color: var(--ink-3); }
  .arch-extras { display: flex; flex-direction: column; gap: 0; margin-top: auto; border: 1px solid rgba(255, 255, 255, .1); }
  .arch-extras > div { padding: 11px 16px; display: grid; grid-template-columns: 116px minmax(0, 1fr); gap: 16px; align-items: baseline; }
  .arch-extras > div + div { border-top: 1px solid rgba(255, 255, 255, .08); }
  .arch-extras .name { font-size: 16px; }
  .arch-extras .b-mono { font-size: 12px; color: var(--ink-3); }

  @media (max-width: 1100px) {
    .arch { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .arch-links { display: none; }
    .arch-col { grid-template-rows: none; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
    .arch-col > .b-micro { grid-column: 1 / -1; }
    .arch-in, .arch-app { min-height: 84px; }
  }
  @media (max-width: 760px) {
    .arch-col { grid-template-columns: minmax(0, 1fr); }
    .stage, .arch-extras > div { grid-template-columns: minmax(0, 1fr); gap: 6px; }
    .arch-core { padding: 24px 20px; }
  }
</style>
