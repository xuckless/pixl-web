---
// Signing in to the PIXL account, or creating one (the same thing): an email
// code, Google or Apple. When it's done (or the visitor already was signed in)
// it sets data-signed-in and fires `pixl:signed-in` on itself, and the page
// decides where to go: see onSignedIn() in src/lib/auth.ts, which also covers
// the event having fired before the page's own script ran. Used by
// /account/sign-in/ and embedded in the beta page.
import '../../styles/account.css'
import { href } from '../../lib/links'
import type { SiteId } from '../../lib/sites'

interface Props {
  site: SiteId
}

const { site } = Astro.props
/** Each brand's primary button (brand.css). */
const CTA: Record<SiteId, string> = { home: 'fo', playroom: 'pri', space: 'sp', engine: 'en' }
---

<div class="signin" data-signin aria-busy="true">
  <form class="signin-step" data-step="email" novalidate>
    <div class="field">
      <label class="b-micro" for="signin-email">Email</label>
      <input id="signin-email" name="email" type="email" autocomplete="email" inputmode="email" required spellcheck="false" />
    </div>
    <div class="signin-check" data-turnstile></div>
    <button class:list={['b-cta', CTA[site]]} type="submit">Email me a code</button>
  </form>

  <form class="signin-step" data-step="code" novalidate hidden>
    <p class="b-body signin-sent">We sent a 6-digit code to <strong data-email></strong>. It works for 10 minutes.</p>
    <div class="field">
      <label class="b-micro" for="signin-code">Code</label>
      <input
        id="signin-code"
        class="code"
        name="code"
        inputmode="numeric"
        autocomplete="one-time-code"
        pattern="[0-9]{6}"
        maxlength="6"
        required
      />
    </div>
    <button class:list={['b-cta', CTA[site]]} type="submit">Sign in</button>
    <div class="signin-links b-body">
      <button type="button" class="linkish" data-resend>Send a new code</button>
      <button type="button" class="linkish" data-other>Use another email</button>
    </div>
  </form>

  <div class="signin-providers" data-providers>
    <div class="signin-or b-micro"><span>or</span></div>
    <button type="button" class="b-cta sec" data-provider="google">
      <svg viewBox="0 0 48 48" aria-hidden="true">
        <path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.6-.4-3.9z"></path>
        <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 8 3l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"></path>
        <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2c-2 1.5-4.5 2.4-7.2 2.4-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"></path>
        <path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z"></path>
      </svg>
      Continue with Google
    </button>
    <button type="button" class="b-cta sec" data-provider="apple">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path fill="currentColor" d="M16.37 1.43c0 1.14-.5 2.27-1.18 3.08-.74.9-1.99 1.57-2.99 1.57-.12 0-.23-.02-.3-.03-.01-.06-.04-.22-.04-.39 0-1.15.57-2.27 1.21-2.98.8-.94 2.14-1.64 3.25-1.68.03.13.05.28.05.43zm4.56 15.71c-.03.07-.46 1.58-1.52 3.12-.94 1.34-1.94 2.71-3.43 2.71-1.52 0-1.9-.88-3.63-.88-1.7 0-2.3.91-3.67.91-1.38 0-2.33-1.26-3.43-2.8C4 18.48 2.96 15.67 2.96 13.02c0-4.28 2.8-6.55 5.55-6.55 1.45 0 2.68.95 3.6.95.87 0 2.22-1.01 3.9-1.01.62 0 2.89.06 4.38 2.19-.13.09-2.38 1.37-2.38 4.19 0 3.26 2.85 4.42 2.95 4.45z"></path>
      </svg>
      Continue with Apple
    </button>
  </div>

  <p class="signin-msg b-body" role="status" aria-live="polite" data-msg></p>

  <p class="fine b-body">
    New here? Signing in creates your account. By continuing you agree to the{' '}
    <a class="textlink" href={href('home', '/legal/eula/', site)}>licence agreement</a> and the{' '}
    <a class="textlink" href={href('home', '/legal/privacy/', site)}>privacy policy</a>.
  </p>
</div>

<script>
  import type { Session } from '@supabase/supabase-js'
  import { errorFromUrl, supabase, TURNSTILE_SITE_KEY } from '../../lib/auth'
  import { challenge, type Challenge } from '../../lib/turnstile'

  /** Supabase's error codes, said plainly; anything else shows Supabase's own message. */
  const MESSAGES: Record<string, string> = {
    over_email_send_rate_limit: 'A code was sent a moment ago. Wait a minute before asking for another.',
    over_request_rate_limit: 'Too many tries. Wait a few minutes and try again.',
    captcha_failed: 'The security check failed. Try again.',
    otp_expired: "That code is wrong or has expired. Check it, or send a new one.",
    email_address_invalid: "That email address doesn't look right.",
    validation_failed: "That email address doesn't look right."
  }
  const RESEND_AFTER_S = 60

  for (const root of document.querySelectorAll<HTMLElement>('[data-signin]')) void init(root)

  async function init(root: HTMLElement): Promise<void> {
    const q = <T extends Element>(sel: string): T => root.querySelector<T>(sel)!
    const emailStep = q<HTMLFormElement>('[data-step="email"]')
    const codeStep = q<HTMLFormElement>('[data-step="code"]')
    const emailInput = q<HTMLInputElement>('#signin-email')
    const codeInput = q<HTMLInputElement>('#signin-code')
    const providers = q<HTMLElement>('[data-providers]')
    const msg = q<HTMLElement>('[data-msg]')
    const resend = q<HTMLButtonElement>('[data-resend]')
    const sb = supabase()

    const say = (text: string, error = false): void => {
      msg.textContent = text
      msg.classList.toggle('error', error)
    }
    const busy = (on: boolean): void => {
      root.setAttribute('aria-busy', String(on))
      root.querySelectorAll<HTMLButtonElement | HTMLInputElement>('button, input').forEach((el) => (el.disabled = on))
      if (!on) tickResend()
    }
    const signedIn = (session: Session): void => {
      root.dataset.signedIn = session.user.email ?? ''
      root.dispatchEvent(new CustomEvent('pixl:signed-in', { bubbles: true, detail: { email: session.user.email } }))
    }
    const failure = (e: unknown): string => {
      const err = e as { code?: string; message?: string }
      return (err.code && MESSAGES[err.code]) || err.message || 'Something went wrong. Try again.'
    }

    // Already signed in, or back from Google or Apple (supabase-js swaps the code in the URL).
    const urlError = errorFromUrl()
    const { data } = await sb.auth.getSession()
    if (data.session) return signedIn(data.session)
    root.setAttribute('aria-busy', 'false')
    if (urlError) say(urlError, true)

    // The security check starts at once, so it has usually passed by the time the email is typed.
    let check: Promise<Challenge> | undefined
    const startCheck = (): Promise<Challenge> => {
      check = challenge(q('[data-turnstile]'), TURNSTILE_SITE_KEY)
      check.catch((e: Error) => say(e.message, true))
      return check
    }
    startCheck()

    let email = ''
    let sentAt = 0
    let timer: number | undefined
    function tickResend(): void {
      const left = Math.ceil(RESEND_AFTER_S - (Date.now() - sentAt) / 1000)
      resend.disabled = left > 0
      resend.textContent = left > 0 ? `Send a new code (${left} s)` : 'Send a new code'
      clearTimeout(timer)
      if (left > 0) timer = window.setTimeout(tickResend, 1000)
    }

    async function sendCode(): Promise<boolean> {
      busy(true)
      say('')
      try {
        const c = await (check ?? startCheck())
        const captchaToken = await c.token()
        const { error } = await sb.auth.signInWithOtp({ email, options: { shouldCreateUser: true, captchaToken } })
        c.reset()
        if (error) throw error
        sentAt = Date.now()
        return true
      } catch (e) {
        say(failure(e), true)
        return false
      } finally {
        busy(false)
      }
    }

    emailStep.addEventListener('submit', async (e) => {
      e.preventDefault()
      email = emailInput.value.trim()
      if (!emailInput.checkValidity() || !email) {
        say('Enter your email address.', true)
        emailInput.focus()
        return
      }
      if (!(await sendCode())) return
      q('[data-email]').textContent = email
      emailStep.hidden = true
      providers.hidden = true
      codeStep.hidden = false
      codeInput.value = ''
      codeInput.focus()
    })

    codeStep.addEventListener('submit', async (e) => {
      e.preventDefault()
      const token = codeInput.value.replace(/\D/g, '')
      if (token.length !== 6) {
        say('The code has 6 digits.', true)
        codeInput.focus()
        return
      }
      busy(true)
      say('')
      const { data, error } = await sb.auth.verifyOtp({ email, token, type: 'email' })
      if (error || !data.session) {
        busy(false)
        say(failure(error), true)
        codeInput.select()
        return
      }
      say('Signed in.')
      signedIn(data.session)
    })

    // Six digits typed or pasted: sign in without a click.
    codeInput.addEventListener('input', () => {
      const digits = codeInput.value.replace(/\D/g, '').slice(0, 6)
      if (digits !== codeInput.value) codeInput.value = digits
      if (digits.length === 6) codeStep.requestSubmit()
    })

    resend.addEventListener('click', async () => {
      if (await sendCode()) {
        say(`A new code is on its way to ${email}.`)
        codeInput.focus()
      }
    })

    q('[data-other]').addEventListener('click', () => {
      codeStep.hidden = true
      emailStep.hidden = false
      providers.hidden = false
      say('')
      emailInput.select()
    })

    // Google and Apple leave the page and come back to it (the URL keeps ?next=).
    root.querySelectorAll<HTMLButtonElement>('[data-provider]').forEach((b) =>
      b.addEventListener('click', async () => {
        busy(true)
        say('')
        const provider = b.dataset.provider as 'google' | 'apple'
        const { error } = await sb.auth.signInWithOAuth({ provider, options: { redirectTo: location.href } })
        if (error) {
          busy(false)
          say(failure(error), true)
        }
      })
    )
  }
</script>
