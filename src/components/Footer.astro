---
// The footer every site shares, as the Family Kit draws it: the brand's rule,
// its name and maker, then the links, then the site's own address.
import { href, origin } from '../lib/links'
import { LEGAL_SITES, type SiteId } from '../lib/sites'
import Bitmap from './brand/Bitmap.astro'
import Wordmark from './Wordmark.astro'

interface Props {
  site: SiteId
}

const { site } = Astro.props
const year = new Date().getFullYear()
// This site's own legal pages, where it has them; else the company site's.
const legal: SiteId = LEGAL_SITES.includes(site) ? site : 'home'
const rule: Record<SiteId, string> = { home: 'fo', playroom: '', space: 'sp', engine: 'en' }
const domain = origin(site).replace(/^https?:\/\//, '')
---

<footer class="foot">
  <div class="wrap">
    <div class:list={['b-rule', rule[site]]}></div>
    <div class="foot-grid">
      <div class="foot-about">
        <div class="foot-brand">
          <a href={href(site, '/', site)} aria-label="Home"><Wordmark site={site} size={13} /></a>
          {
            site !== 'home' && (
              <a class="maker b-body" href={href('home', '/', site)}>
                A product of <Bitmap cell={2} label="PIXL Foundation" />
              </a>
            )
          }
        </div>
        <p class="b-body">Imaging software, from the pixel up.</p>
      </div>
      <div>
        <h2 class="b-micro">Products</h2>
        <ul class="b-body">
          <li><a href={href('playroom', '/', site)}>Pixl Playroom</a></li>
          <li><a href={href('space', '/', site)}>Space Pixl</a></li>
          <li><a href={href('engine', '/', site)}>PIXL Engine</a></li>
        </ul>
      </div>
      <div>
        <h2 class="b-micro">Company</h2>
        <ul class="b-body">
          <li><a href={href('home', '/#about', site)}>About</a></li>
          <li><a href={href('home', '/#press', site)}>Press kits</a></li>
          <li><a href="https://github.com/xuckless">GitHub</a></li>
          <li><a href="mailto:hello@pixlfoundation.com">Contact</a></li>
        </ul>
      </div>
      <div>
        <h2 class="b-micro">Legal</h2>
        <ul class="b-body">
          <li><a href={href(legal, '/legal/eula/', site)}>Licence agreement</a></li>
          <li><a href={href(legal, '/legal/privacy/', site)}>Privacy</a></li>
          <li><a href={href(legal, '/legal/third-party/', site)}>Third-party notices</a></li>
        </ul>
      </div>
    </div>
    <div class="foot-base b-body">
      <span>© {year} PIXL Foundation</span>
      <span class="b-mono">{domain}</span>
    </div>
  </div>
</footer>
